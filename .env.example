# ── SIGUC-AC · Variáveis de Ambiente ─────────────────────────────

# Supabase (obrigatório — também definir no Vercel Dashboard)
SUPABASE_URL=https://atqtybcsvepdabsvgaly.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ── Observabilidade (Regra 9) — Thresholds de alertas ────────────
ALERT_ERROR_RATE_THRESHOLD=0.05        # 5% de requisições com erro
ALERT_LATENCY_P99_THRESHOLD=2000       # P99 acima de 2s
ALERT_MEMORY_THRESHOLD=0.85            # 85% do heap limit
ALERT_CACHE_MISS_THRESHOLD=0.40        # Miss rate acima de 40%

# Webhook para alertas (Slack/Discord — opcional)
ALERT_WEBHOOK_URL=

# ── Deploy (Regra 10) ─────────────────────────────────────────────
HEALTH_URL=https://siguc-ac.vercel.app/api/health
LIVE_URL=https://siguc-ac.vercel.app/api/health/live

# ── Testes (Regra 8) ──────────────────────────────────────────────
TEST_BASE_URL=http://localhost:5500
